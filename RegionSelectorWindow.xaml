<Window x:Class="GameChatTranslator.UI.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1A000000"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        ResizeMode="NoResize">

    <Canvas x:Name="RootCanvas">

        <Border x:Name="Hint"
                Background="#DD202020"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,13">
            <StackPanel>
                <TextBlock Text="ลากกรอบคลุมช่องแชตในเกม"
                           Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="ลากให้ชิดพอดี ยิ่งกรอบเล็กยิ่งเร็วและแม่น · กด Esc เพื่อยกเลิก"
                           Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Rectangle x:Name="SelectionBox"
                   Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                   Fill="#334CC2A0" Visibility="Collapsed"/>

        <TextBlock x:Name="SizeLabel"
                   Foreground="{StaticResource Ink}" FontSize="12"
                   FontFamily="Consolas" Visibility="Collapsed"/>

    </Canvas>
</Window>
